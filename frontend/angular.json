{
  "version": 1,
  "projects": {
    "reuse-campus": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/reuse-campus"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "reuse-campus:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "f63d44ec-88a9-494e-8a64-21a3b6a17935"
  }
}
